{
  "name": "@pleisto/active-support",
  "version": "1.6.0",
  "description": "A TypeScript utility library designed to optimize for programmer happiness.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pleisto/active-support.git"
  },
  "bugs": {
    "url": "https://github.com/pleisto/active-support"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "node": "24.11.1"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "lint": "bun run lint:eslint && bun run lint:type",
    "lint:eslint": "TIMING=1 bunx eslint --cache src",
    "lint:fix": "TIMING=1 bunx eslint src --fix",
    "lint:type": "bun run tsc",
    "build": "bunx tsup --format esm,cjs --clean --dts",
    "build:esm": "bunx tsup --format esm --clean --dts",
    "build:cjs": "bunx tsup --format cjs --clean --dts",
    "build:bun": "bunx tsup --format esm,cjs --clean --dts",
    "test": "bun run vitest run --coverage",
    "test:watch": "bun run vitest --watch",
    "test:bench": "bun run vitest bench",
    "test:bun": "bunx vitest run --coverage",
    "test:watch:bun": "bunx vitest --watch",
    "tsdoc": "bunx typedoc --options typedoc.json --out ./docs/api ./src/index.ts",
    "prepublishOnly": "bun run build",
    "publish:package": "npm publish --access public --provenance=false"
  },
  "sideEffects": false,
  "dependencies": {
    "@lukeed/uuid": "^2.0.1",
    "fast-deep-equal": "^3.1.3",
    "moize": "^6.1.7",
    "ms": "^2.1.3",
    "neverthrow": "^8.2.0",
    "radash": "^12.1.1",
    "ts-pattern": "^5.9.0",
    "type-fest": "^5.7.0"
  },
  "devDependencies": {
    "@pleisto/eslint-plugin": "2.5.3",
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "10.4.1",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-inline-sources": "^1.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "packageManager": "bun@1.3.14"
}
